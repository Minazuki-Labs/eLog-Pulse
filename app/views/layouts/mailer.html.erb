<!DOCTYPE html>
<html>
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <style>
      body { background-color: #f8fafc; font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif; margin: 0; padding: 0; }
    </style>
  </head>
  <body style="background-color: #f8fafc; padding: 30px 0;">
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #f8fafc;">
      <tr>
        <td align="center">
          <table width="680" border="0" cellspacing="0" cellpadding="0" style="background-color: #ffffff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);">
            <tr>
              <td style="padding: 24px 32px; border-bottom: 1px solid #f1f5f9; background-color: #ffffff;">
                <span style="font-size: 20px; font-weight: 900; color: #1e293b; letter-spacing: -0.05em;">
                  eLog <span style="color: #2563eb;">Dynabook</span>
                </span>
              </td>
            </tr>
            <tr>
              <td style="padding: 32px;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td style="padding: 20px 32px; background-color: #f8fafc; border-top: 1px solid #f1f5f9; text-align: center;">
                <p style="margin: 0; font-size: 12px; color: #64748b; font-weight: 500;">
                  eLog Dynabook @JuneMinazuki, 2026
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
