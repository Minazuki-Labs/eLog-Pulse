    <% elsif current_user.staff? %>
      <%= sidebar_link "Dashboard", root_path, "squares-2x2" %>
      <% unless current_user.contractor? %>
        <%= sidebar_link "Create New Ticket", new_ticket_path, "plus-circle" %>
        <%= sidebar_link "New Tickets", tickets_path(scope: 'open'), "inbox" %>
      <% end %>
      <%= sidebar_link "In Progress Tickets", tickets_path(scope: 'in_progress'), "clock" %>
      <%= sidebar_link "Completed Tickets", tickets_path(scope: 'completed'), "check-circle" %>

      <% if current_user.admin? %>
        <div class="pt-4 mt-4 border-t border-gray-100">
          <p class="px-5 text-[13px] font-black text-slate-900 uppercase tracking-[0.2em] mb-6">Admin Tools</p>
          <%= sidebar_link "Equipment Directory", equipment_categories_path, "clipboard-document-list" %>
          <%= sidebar_link "School Directory", schools_users_path, "building-office" %>
          <%= sidebar_link "Staff Management", employees_users_path, "users" %>
          <%# <%= sidebar_link "Location Templates", "#", "rectangle-group" %>
          <div class="group flex items-center gap-4 px-5 py-3.5 text-sm font-medium rounded-xl text-gray-400 opacity-50 pointer-events-none cursor-not-allowed">
            <svg class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18a2.25 2.25 0 0 1-2.25 2.25H6A2.25 2.25 0 0 1 3.75 18v-2.25ZM13.5 6a2.25 2.25 0 0 1 2.25-2.25H18A2.25 2.25 0 0 1 20.25 6v2.25A2.25 2.25 0 0 1 18 10.5h-2.25a2.25 2.25 0 0 1-2.25-2.25V6ZM13.5 15.75a2.25 2.25 0 0 1 2.25-2.25H18a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25A2.25 2.25 0 0 1 13.5 18v-2.25Z" />
