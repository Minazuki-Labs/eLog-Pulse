<aside class="w-72 flex-shrink-0 px-6 pt-10 border-r border-gray-50">
  <nav class="space-y-1">

    <div class="space-y-1" data-controller="toggle" data-toggle-id-value="helpdesk">
      <button type="button" data-action="click->toggle#toggle" class="w-full flex items-center justify-between px-5 text-[13px] font-black text-slate-900 uppercase tracking-[0.2em] mb-2 focus:outline-none cursor-pointer">
        <span>Helpdesk</span>
        <svg data-toggle-target="icon" class="w-4 h-4 transition-transform duration-200 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>

      <div data-toggle-target="content" class="grid grid-rows-[1fr] opacity-100 visible transition-all duration-300 ease-in-out overflow-hidden">
        <div class="overflow-hidden min-h-0 space-y-1 p-2">
          <% if current_user.school? %>
            <%= sidebar_link "Dashboard", root_path, "squares-2x2" %>
            <%= sidebar_link "My Tickets", tickets_path, "ticket" %>
            <%= sidebar_link "Create New Ticket", new_ticket_path, "plus-circle" %>

          <% elsif current_user.staff? %>
            <%= sidebar_link "Dashboard", root_path, "squares-2x2" %>
            <% unless current_user.contractor? %>
              <%= sidebar_link "Create New Ticket", new_ticket_path, "plus-circle" %>
              <%= sidebar_link "New Tickets", tickets_path(scope: 'open'), "inbox" %>
            <% end %>
            <%= sidebar_link "In Progress Tickets", tickets_path(scope: 'in_progress'), "clock" %>
            <%= sidebar_link "Completed Tickets", tickets_path(scope: 'completed'), "check-circle" %>
          <% end %>

          <% unless current_user.admin? %>
            <%= sidebar_link "Settings", edit_setting_path, "cog-6-tooth" %>
          <% end %>
        </div>
      </div>
    </div>

    <% if current_user.admin? || current_user.teacher? || current_user.manager? || current_user.contractor? %>
      <div class="pt-4 mt-4 border-t border-gray-100 space-y-1" data-controller="toggle" data-toggle-id-value="stock-order">
        <button type="button" data-action="click->toggle#toggle" class="w-full flex items-center justify-between px-5 text-[13px] font-black text-slate-900 uppercase tracking-[0.2em] mb-2 focus:outline-none cursor-pointer">
          <span>Stock Order</span>
          <svg data-toggle-target="icon" class="w-4 h-4 transition-transform duration-200 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div data-toggle-target="content" class="grid grid-rows-[1fr] opacity-100 visible transition-all duration-300 ease-in-out overflow-hidden">
          <div class="overflow-hidden min-h-0 space-y-1 p-2">
            <% if current_user.admin? || current_user.teacher? %>
              <%= sidebar_link "Create New Order", new_stock_order_path, "plus-circle" %>
            <% end %>
            <% if current_user.teacher? %>
              <%= sidebar_link "My Stock Orders", stock_orders_path, "shopping-cart" %>
            <% end %>
            <% if current_user.admin? || current_user.manager? || current_user.contractor? %>
              <%= sidebar_link "Pending Orders", pending_stock_orders_path, "clock" %>
            <% end %>
            <% if current_user.admin? || current_user.teacher? %>
              <%= sidebar_link "Completed Orders", completed_stock_orders_path, "check-circle" %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <% if current_user.admin? %>
      <div class="pt-4 mt-4 border-t border-gray-100 space-y-1" data-controller="toggle" data-toggle-id-value="admin-tools">
        <button type="button" data-action="click->toggle#toggle" class="w-full flex items-center justify-between px-5 text-[13px] font-black text-slate-900 uppercase tracking-[0.2em] mb-2 focus:outline-none cursor-pointer">
          <span>Admin Tools</span>
          <svg data-toggle-target="icon" class="w-4 h-4 transition-transform duration-200 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>

        <div data-toggle-target="content" class="grid grid-rows-[1fr] opacity-100 visible transition-all duration-300 ease-in-out overflow-hidden">
          <div class="overflow-hidden min-h-0 space-y-1 p-2">
            <%= sidebar_link "Equipment Directory", equipment_categories_path, "clipboard-document-list" %>
            <%= sidebar_link "Stock Directory", stock_items_path, "archive-box" %>
            <%= sidebar_link "School Directory", schools_users_path, "building-office" %>
            <%= sidebar_link "Staff Management", employees_users_path, "users" %>
            <%= sidebar_link "Company Directory", companies_path, "building-storefront" %>
            <%= sidebar_link "Settings", edit_setting_path, "cog-6-tooth" %>
          </div>
        </div>
      </div>
    <% end %>
  </nav>
</aside>
