<div class="max-w-5xl mx-auto py-10 px-4">
  <div class="flex items-center justify-between mb-8">
    <%= link_to root_path, class: "group flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors" do %>
      <svg class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      <span class="font-semibold">Back to Dashboard</span>
    <% end %>
    <h1 class="text-3xl font-black text-slate-900 tracking-tight">
      Account Settings
    </h1>
  </div>

  <% target_user = @user.school? ? @school : @employee %>

  <%= form_with(model: target_user, url: setting_path, method: :patch, data: { controller: "role-warning" }, class: "space-y-10") do |f| %>

    <% if current_user.admin? %>
      <div class="bg-white rounded-[2.5rem] p-8 md:p-12 shadow-xl shadow-slate-200/40 border border-slate-100 space-y-6">
        <div>
          <h2 class="text-xl font-black text-slate-900 tracking-tight">Global Application Configuration</h2>
          <p class="text-xs text-slate-400 mt-1">System-wide settings applicable to all users and automated emails.</p>
        </div>

        <div class="space-y-4">
          <div>
            <%= label_tag "app_config[group_email]", "Group Notification Email", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5 ml-1" %>
            <%= text_field_tag "app_config[group_email]", AppConfig.group_email, 
                placeholder: "notifications@example.com",
                class: "block w-full px-4 py-3.5 border-2 border-slate-100 bg-slate-50 rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all text-slate-700" %>
          </div>
        </div>
      </div>
    <% end %>

    <%= render "users/form", user: target_user, url: setting_path, button_label: false %>

    <div class="flex items-center justify-end gap-3 pt-2">
      <%= link_to "Cancel", root_path, class: "px-5 py-3.5 text-sm font-bold text-slate-500 hover:bg-slate-50 rounded-2xl transition-all" %>
      <%= f.submit "Update Settings", class: "px-6 py-3.5 bg-blue-600 text-white text-sm font-bold rounded-2xl shadow-md shadow-blue-100 hover:bg-blue-700 transition-all cursor-pointer" %>
    </div>

  <% end %>
</div>
