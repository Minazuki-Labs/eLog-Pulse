<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <style>
    @page {
      size: A4 portrait;
      margin: 10mm;
    }

    body, div, table, th, td, span, p, h1 {
      font-family: "WenQuanYi Micro Hei", "WenQuanYi Zen Hei", Helvetica, Arial, sans-serif !important;
    }
  </style>
</head>
<body style="margin: 0; padding: 0;">
  <div style="max-width: 100%; margin: 0 auto; padding: 16px; color: #1e293b; background: #ffffff; box-sizing: border-box;">
    
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid #e2e8f0; padding-bottom: 16px; margin-bottom: 20px;">
      <div>
        <h1 style="font-size: 20px; font-weight: 800; color: #0f172a; margin: 0;">Completed Tickets Report</h1>
        <p style="font-size: 12px; color: #64748b; margin: 4px 0 0 0;">Resolved hardware & IT support tickets summary log</p>
      </div>
      <div style="text-align: right; font-size: 12px; color: #475569;">
        <p style="margin: 0;"><strong>User:</strong> <%= current_user.name %></p>
        <p style="margin: 4px 0 0 0;"><strong>Date:</strong> <%= Date.today.strftime("%d %b %Y") %></p>
      </div>
    </div>

    <!-- Summary Bar -->
    <div style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 12px 16px; margin-bottom: 20px; font-size: 12px;">
      <span style="color: #64748b;">Total Tickets:</span> <strong style="color: #0f172a; margin-right: 20px;"><%= @tickets.count %></strong>
      <span style="color: #64748b;">Status:</span> <strong style="color: #059669; margin-right: 20px;">All Resolved</strong>
      <% if @institution.present? %>
        <span style="color: #64748b;">Institution:</span> <strong style="color: #0f172a;"><%= @institution.name %></strong>
      <% end %>
    </div>

    <!-- Table -->
    <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 12px;">
      <thead>
        <tr style="border-bottom: 1px solid #e2e8f0; font-size: 10px; font-weight: 600; color: #64748b; text-transform: uppercase; background-color: #f8fafc;">
          <th style="padding: 10px 12px; width: 10%;">Case ID</th>
          <th style="padding: 10px 12px; width: 15%;">Date</th>
          <th style="padding: 10px 12px; width: 12%;">Status</th>
          <th style="padding: 10px 12px; width: 43%;">Device & Issue Details</th>
          <th style="padding: 10px 12px; width: 20%;">Requested By / Location</th>
        </tr>
      </thead>
      <tbody>
        <% @tickets.each do |ticket| %>
          <% last_user_comment = ticket.comments.user_note.order(created_at: :desc).first %>
          <tr style="border-bottom: 1px solid #f1f5f9;">
            <td style="padding: 12px; font-weight: bold; color: #0f172a; vertical-align: top;">#<%= ticket.id %></td>
            <td style="padding: 12px; color: #475569; vertical-align: top; white-space: nowrap;"><%= ticket.created_at.strftime("%d %b %Y") %></td>
            <td style="padding: 12px; vertical-align: top;">
              <span style="display: inline-block; padding: 3px 6px; font-size: 9px; font-weight: bold; background-color: #d1fae5; color: #065f46; border-radius: 4px;">COMPLETED</span>
            </td>
            <td style="padding: 12px; vertical-align: top; word-break: break-word;">
              <div style="font-weight: bold; color: #0f172a; text-transform: uppercase;"><%= ticket.equipment&.display_name || "Equipment ##{ticket.equipment_id}" %></div>
              <div style="color: #475569; margin-top: 4px;"><%= ticket.description %></div>
              
              <% if last_user_comment.present? %>
                <!-- Last User Note -->
                <div style="margin-top: 8px; font-size: 10px; background-color: #f8fafc; border-left: 3px solid #6366f1; padding: 6px 8px; color: #475569;">
                  <div style="font-weight: 600; color: #4f46e5;">
                    Last Note by <%= last_user_comment.user&.name || "User" %> (<%= last_user_comment.created_at.strftime("%d %b %Y") %>):
                  </div>
                  <div style="margin-top: 2px;"><%= last_user_comment.body %></div>
                </div>
              <% end %>
            </td>
            <td style="padding: 12px; vertical-align: top;">
              <div style="color: #334155;"><%= ticket.school&.name %></div>
              <div style="font-weight: bold; color: #0f172a; text-transform: uppercase; margin-top: 2px;"><%= ticket.location&.name %></div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</body>
</html>
