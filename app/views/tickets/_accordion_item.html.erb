<% state_name = state_group[:state] %>
<% total_state_tickets = state_group[:schools].sum { |s| s[:tickets].count } %>
<% state_has_warning = current_user.staff? && state_group[:schools].any? { |sg| sg[:tickets].any?(&:warning?) } %>

<details name="states-accordion" data-dashboard-accordion-target="state" class="border border-slate-200 rounded-2xl bg-white shadow-sm overflow-hidden transition-all">
  <summary class="flex items-center justify-between w-full p-5 cursor-pointer bg-slate-50/50 hover:bg-slate-100/80 transition-colors select-none">
    <div class="flex items-center">
      <span class="w-3 h-3 bg-indigo-500 rounded-full mr-3"></span>
      <h2 class="text-lg font-bold text-slate-700"><%= state_name.titleize %></h2>
      <span class="ml-3 text-xs font-medium text-slate-400 bg-slate-200/70 px-2.5 py-0.5 rounded-full">
        <%= total_state_tickets %> tickets
      </span>
      <% if state_has_warning %>
        <span class="ml-2 inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200/60" title="Contains tickets requiring attention">
          <svg class="w-3.5 h-3.5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
          </svg>
          Warning
        </span>
      <% end %>
    </div>
    
    <svg class="w-5 h-5 text-slate-400 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
    </svg>
  </summary>

  <div class="p-5 space-y-4 border-t border-slate-100 bg-slate-50/30">
    <% state_group[:schools].each do |school_group| %>
      <% school = school_group[:school] %>
      <% school_tickets = school_group[:tickets] %>
      <% school_has_warning = current_user.staff? && school_tickets.any?(&:warning?) %>

      <details name="schools-accordion-<%= state_name.parameterize %>" data-dashboard-accordion-target="school" class="border border-slate-200/80 rounded-xl bg-white shadow-sm overflow-hidden transition-all">
        <summary class="flex items-center justify-between w-full p-4 cursor-pointer bg-white hover:bg-slate-50 transition-colors select-none">
          <div class="flex items-center">
            <div class="h-7 w-7 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 mr-3">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-7h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
            </div>
            <h3 class="text-base font-bold text-slate-700 uppercase"><%= school.name %></h3>
            <span class="ml-3 text-xs font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full">
              <%= school_tickets.count %>
            </span>
            <% if school_has_warning %>
              <span class="ml-2 inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800 border border-amber-200/60" title="Contains tickets requiring attention">
                <svg class="w-3.5 h-3.5 text-amber-600 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                </svg>
                Warning
              </span>
            <% end %>
          </div>

          <svg class="w-4 h-4 text-slate-400 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>

        <div class="p-5 border-t border-slate-100 bg-slate-50/50">
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <%= render partial: "home/ticket_card", collection: school_tickets, as: :ticket, locals: { show_school: false } %>
          </div>
        </div>
      </details>
    <% end %>
  </div>
</details>
