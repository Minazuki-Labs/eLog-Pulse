<div class="max-w-5xl mx-auto py-10 px-4">
  <div class="flex items-center justify-between mb-6">
    <% default_path = current_user.school? ? tickets_path : root_path %>
    <% back_path = session[:last_tickets_path] || default_path %>

    <%= link_to back_path, class: "group flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors" do %>
      <svg class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      <span class="font-semibold">Back to Tickets</span>
    <% end %>

    <div class="flex items-center gap-2">
      <% if !@ticket.completed? && current_user == @ticket.school %>
        <%= link_to edit_ticket_path(@ticket), 
            class: "p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-xl transition-all", 
            title: "Edit Ticket" do %>
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        <% end %>
      <% end %>
    </div>
  </div>

  <%= render "tickets/details", ticket: @ticket %>
</div>

<div class="max-w-5xl mx-auto px-4 pb-20">
  <div class="mt-12 space-y-8">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-4">
        <h3 class="text-2xl font-black text-slate-900 tracking-tight">Activity Log</h3>
        <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-600 text-xs font-black ring-1 ring-inset ring-blue-200/50">
          <%= @ticket.comments.count %>
        </span>
      </div>
    </div>

    <% if current_user.staff? %>
      <div class="bg-white rounded-[2rem] p-4 shadow-xl shadow-slate-200/40 border border-slate-100">
        <%= form_with(model: [ @ticket, @comment || Comment.new ], class: "space-y-3 relative") do |f| %>
          <% if @comment && @comment.errors.any? %>
            <div class="px-5 py-3.5 bg-rose-50 border border-rose-200/80 text-rose-700 rounded-[1.2rem] text-sm font-semibold flex items-center gap-2">
              <svg class="w-5 h-5 flex-shrink-0 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
              <span><%= @comment.errors.full_messages.to_sentence %></span>
            </div>
          <% end %>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
            <div class="relative flex-1">
              <div class="absolute inset-y-0 left-0 pl-5 flex items-center pointer-events-none text-slate-400">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012-2m-6 9l2 2 4-4"></path>
                </svg>
              </div>
              <%= f.text_field :jobsheet, 
                  required: true,
                  placeholder: "Jobsheet reference number (Required)", 
                  class: "w-full rounded-[1.4rem] border-none bg-slate-50 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all pl-12 pr-6 py-3.5 text-sm font-semibold text-slate-700 placeholder:text-slate-400" 
              %>
            </div>

            <% unless @ticket.completed? || current_user.contractor? %>
              <label class="peer flex items-center gap-3 px-5 py-3.5 rounded-[1.4rem] cursor-pointer transition-all select-none border-2 shrink-0 shadow-sm 
                            bg-blue-50/60 hover:bg-blue-100/60 border-blue-200/60 text-blue-900
                            has-[:checked]:bg-emerald-50 has-[:checked]:hover:bg-emerald-100/80 has-[:checked]:border-emerald-500/50 has-[:checked]:text-emerald-700">
                <%= check_box_tag :complete_case, "1", false, 
                    class: "w-5 h-5 rounded-lg border-blue-400 text-emerald-600 focus:ring-emerald-500/20 cursor-pointer transition-colors" 
                %>
                <span class="text-xs font-black uppercase tracking-wider">Complete Case</span>
              </label>
            <% end %>
          </div>

          <div class="relative">
            <%= f.text_area :body, 
                placeholder: "Type a technical note or status update...", 
                class: "w-full rounded-[1.4rem] border-none bg-slate-50 focus:bg-white focus:ring-4 focus:ring-blue-500/10 transition-all p-6 pb-16 text-slate-700 placeholder:text-slate-400 min-h-[120px] resize-none" 
            %>
            <div class="absolute bottom-4 right-4">
              <%= f.submit "Post Comment", 
                  class: "bg-slate-900 hover:bg-blue-600 text-white px-6 py-2.5 rounded-xl font-bold text-sm transition-all transform active:scale-95 flex items-center gap-2 shadow-lg shadow-blue-500/20" 
              %>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="space-y-8 relative before:absolute before:inset-0 before:ml-5 before:-translate-x-px before:h-full before:w-0.5 before:bg-slate-200">
        <%= render partial: "tickets/comment", collection: @ticket.comments.order(created_at: :desc) %>
    </div>
  </div>
</div>
