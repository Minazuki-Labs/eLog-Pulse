<main class="flex-1 p-8 lg:p-12">   
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
      <div>
        <% page_title = ticket_page_title %>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
          <%= page_title %>
        </h1>
        
        <p class="text-slate-400 mt-1 text-base">
          <%= ticket_page_description %>
        </p>
      </div>
      
      <div class="w-full sm:w-auto">
        <%= form_with url: tickets_path, method: :get, class: "flex items-center gap-3 w-full sm:w-auto" do |f| %>
          <%= hidden_field_tag :scope, params[:scope] if params[:scope].present? %>
          
          <div class="relative w-full sm:w-80 group">
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-slate-400 group-focus-within:text-blue-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <%= f.text_field :query, 
                placeholder: "Search tickets...", 
                class: "block w-full pl-12 pr-4 py-3.5 border-2 border-slate-100 rounded-2xl bg-white text-sm font-medium placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all shadow-md hover:shadow-lg",
                value: params[:query] %>
          </div>

          <div class="relative">
            <details class="group relative">
              <summary class="list-none flex items-center justify-center p-3.5 border-2 border-slate-100 rounded-2xl bg-white text-slate-400 hover:text-blue-600 hover:bg-blue-50 cursor-pointer shadow-md hover:shadow-lg transition-all select-none focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500" title="Filter Tickets">
                <div class="relative flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                  </svg>
                  
                  <% if params[:school_id].present? || params[:start_date].present? || params[:end_date].present? %>
                    <span class="absolute -top-1 -right-1 flex h-2 w-2 rounded-full bg-blue-600"></span>
                  <% end %>
                </div>
              </summary>

              <div class="absolute right-0 mt-3 w-80 bg-white rounded-2xl shadow-xl border border-slate-100 p-6 z-50 space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                  <h3 class="font-bold text-slate-900 text-base">Filter Tickets</h3>
                  <%= link_to "Reset", tickets_path(scope: params[:scope], query: params[:query]), class: "text-xs font-semibold text-blue-600 hover:text-blue-800" %>
                </div>

                <% if @schools.present? %>
                  <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">School</label>
                    <%= select_tag :school_id, 
                        options_from_collection_for_select(@schools, :id, ->(s) { s.try(:name) || s.email }, params[:school_id]), 
                        include_blank: "All Schools",
                        class: "w-full rounded-xl border-2 border-slate-100 px-3 py-2.5 text-sm font-medium text-slate-700 focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 bg-white" %>
                  </div>
                <% end %>

                <div>
                  <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">Date Range</label>
                  <div class="space-y-2.5">
                    <div>
                      <span class="text-xs text-slate-400 mb-1 block font-medium">From</span>
                      <div class="relative group/date">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 group-focus-within/date:text-blue-600 transition-colors">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                          </svg>
                        </div>
                        <%= date_field_tag :start_date, params[:start_date], 
                            class: "w-full rounded-xl border-2 border-slate-100 pl-10 pr-3 py-2.5 text-sm font-medium text-slate-700 focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 bg-white transition-all shadow-sm" %>
                      </div>
                    </div>

                    <div>
                      <span class="text-xs text-slate-400 mb-1 block font-medium">To</span>
                      <div class="relative group/date">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400 group-focus-within/date:text-blue-600 transition-colors">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                          </svg>
                        </div>
                        <%= date_field_tag :end_date, params[:end_date], 
                            class: "w-full rounded-xl border-2 border-slate-100 pl-10 pr-3 py-2.5 text-sm font-medium text-slate-700 focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 bg-white transition-all shadow-sm" %>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="pt-2">
                  <%= f.submit "Apply Filters", class: "w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-md transition-all text-center cursor-pointer" %>
                </div>
              </div>
            </details>
          </div>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <%= render partial: "home/ticket_card", collection: @tickets, as: :ticket %>
    </div>
  </div>
</main>
