<main class="flex-1 p-8 lg:p-12" data-controller="dashboard-accordion">   
  <div class="max-w-5xl mx-auto">
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-10">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">
          <%= ticket_page_title %>
        </h1>
        
        <p class="text-slate-400 mt-1 text-base">
          <%= ticket_page_description %>
        </p>
      </div>
      
      <div class="flex items-center gap-3">
        <% if @scope == "completed" && @tickets.present? %>
          <%= link_to tickets_path(request.parameters.merge(format: :pdf)), 
              class: "inline-flex items-center justify-center px-5 py-3.5 bg-blue-600 text-white text-sm font-bold rounded-2xl shadow-md shadow-blue-100 hover:bg-blue-700 transition-all shrink-0 w-full sm:w-auto",
              target: "_blank" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Export PDF
          <% end %>
        <% end %>

        <%= render "tickets/searchbar" %>
      </div>
    </div>

    <% if current_user.school? %>
      <%= render "tickets/school_dashboard" %>
    <% elsif @scope == "completed" %>
      <%= render "completed_index" %>
    <% else %>
      <div class="space-y-4">
        <% if @states_data.blank? %>
          <div class="bg-white rounded-2xl p-8 text-center border border-slate-200/60 text-slate-400">
            No tickets found for this view.
          </div>
        <% else %>
          <%= render partial: "tickets/accordion_item", collection: @states_data, as: :state_group %>
        <% end %>
      </div>
    <% end %>
  </div>
</main>
