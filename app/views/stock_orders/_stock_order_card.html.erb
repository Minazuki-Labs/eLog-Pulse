<%= link_to stock_order_path(stock_order), class: "group relative bg-white rounded-3xl p-7 border border-slate-200/60 shadow-sm hover:shadow-xl hover:shadow-blue-500/10 hover:-translate-y-1 transition-all duration-300 flex flex-col h-full overflow-hidden" do %>
  <div class="flex justify-between items-start mb-6">
    <div class="flex flex-col gap-1.5">
      <span class="px-2.5 py-0.5 rounded-lg text-[11px] font-bold uppercase tracking-widest bg-slate-100 text-slate-600 tabular-nums w-fit">
        Order ID: #<%= stock_order.id %>
      </span>

      <span class="px-2.5 py-0.5 rounded-lg text-[11px] font-bold uppercase tracking-widest bg-blue-50 text-blue-600 w-fit">
        <%= stock_order.status.humanize %>
      </span>
    </div>
    
    <span class="text-[11px] font-semibold text-slate-400 tabular-nums whitespace-nowrap">
      <%= stock_order.created_at.strftime("%d %b %Y") %>
    </span>
  </div>

  <div class="mb-6">
    <% if stock_order.company.present? %>
      <h3 class="text-xl font-extrabold text-slate-800 group-hover:text-blue-600 transition-colors leading-tight mb-2">
        <%= stock_order.company&.name %>
      </h3>
    <% end %>

    <p class="text-slate-500 text-sm leading-relaxed line-clamp-2">
      Items: <%= stock_order.stock_sub_items.pluck(:name).join(', ').presence || "No items listed" %>
    </p>
  </div>

  <div class="mt-auto pt-5 border-t border-slate-50 flex items-center justify-between">
    <div class="flex flex-col">
      <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Ordered By</span>
      <span class="text-xs font-bold text-slate-700 uppercase tracking-tight"><%= stock_order.user&.name %></span>
    </div>
    
    <div class="bg-blue-50 text-blue-600 p-2 rounded-xl group-hover:bg-blue-600 group-hover:text-white transition-all">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
    </div>
  </div>

  <div class="absolute inset-x-0 bottom-0 h-1 bg-gradient-to-r from-blue-500 to-indigo-600 scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-500"></div>
<% end %>
