<main class="flex-1 p-8 lg:p-12">
  <div class="max-w-5xl mx-auto py-10 px-4">
    <div class="flex items-center justify-between mb-6">
      <%= link_to stock_orders_path, class: "group flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors" do %>
        <svg class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <span class="font-semibold">Back to Stock Orders</span>
      <% end %>

      <div class="flex items-center">
        <% if current_user.admin? %>
          <%= link_to stock_order_path(@stock_order), 
              data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this stock order?" }, 
              class: "p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all", 
              title: "Delete Stock Order" do %>
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          <% end %>
        <% end %>
      </div>
    </div>

    <%= render "stock_orders/details", stock_order: @stock_order %>
  </div>
</main>
