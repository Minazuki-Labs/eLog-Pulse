<div class="bg-white rounded-[2rem] shadow-xl shadow-slate-200/60 border border-slate-100 overflow-hidden">
  <div class="flex flex-col md:flex-row">
    <div class="flex-1 p-8 md:p-12">
      <div class="mb-10">
        <div class="flex justify-between items-center gap-4 flex-wrap">
          <div class="flex items-center">
            <% if current_user.admin? %>
              <%= form_with model: stock_order, class: "inline-block" do |f| %>
                <div class="relative group cursor-pointer">
                  <span class="inline-flex items-center px-4 py-2.5 pr-10 rounded-full text-[11px] font-black uppercase tracking-widest <%= stock_status_color(stock_order.status) %> ring-1 ring-inset ring-black/5 transition-all group-hover:ring-black/20 shadow-sm">
                    <%= stock_order.status.humanize %>
                  </span>
                  
                  <div class="absolute right-3 top-1/2 -translate-y-1/2 text-current opacity-60 group-hover:opacity-100 transition-opacity">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path>
                    </svg>
                  </div>

                  <%= f.select :status, 
                      StockOrder.statuses.keys.map { |s| [s.titleize, s] }, 
                      {}, 
                      { 
                        class: "absolute inset-0 w-full h-full opacity-0 cursor-pointer z-10",
                        onchange: "this.form.requestSubmit()" 
                      } 
                  %>
                </div>
              <% end %>
            <% else %>
              <span class="inline-flex items-center px-4 py-2.5 rounded-full text-[11px] font-black uppercase tracking-widest <%= stock_status_color(stock_order.status) %> ring-1 ring-inset ring-black/5">
                <%= stock_order.status.humanize %>
              </span>
            <% end %>
          </div>

          <span class="inline-flex items-center px-4 py-2.5 rounded-full text-[11px] font-black uppercase tracking-widest bg-slate-100 text-slate-600 ring-1 ring-inset ring-slate-200/60 tabular-nums whitespace-nowrap">
            Order ID: #<%= stock_order.id %>
          </span>
        </div>

        <h1 class="text-4xl font-black text-slate-900 mt-4 tracking-tight leading-tight">
          Stock Order Request
        </h1>
        <p class="text-xl text-slate-500 font-medium mt-1"><%= stock_order.school&.name %></p>
      </div>

      <div class="space-y-4 mb-8">
        <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"></path></svg>
          Ordered Items (<%= stock_order.stock_order_items.count %>)
        </h4>
        
        <% is_approver = (stock_order.approver_1_id == current_user.id) || (stock_order.approver_2_id == current_user.id) %>

        <div class="border border-slate-100 rounded-2xl overflow-hidden bg-slate-50/50">
          <table class="min-w-full divide-y divide-slate-100">
            <thead class="bg-slate-100/60">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-black text-slate-500 uppercase tracking-wider">Item / Sub-Item</th>
                <th class="px-6 py-3 text-right text-xs font-black text-slate-500 uppercase tracking-wider">Quantity</th>
                <% if current_user.admin? || is_approver %>
                  <th class="px-6 py-3 text-right text-xs font-black text-slate-500 uppercase tracking-wider">Action</th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              <% stock_order.stock_order_items.includes(stock_sub_item: :stock_item).each do |item| %>
                <tr>
                  <td class="px-6 py-4 text-sm font-bold text-slate-800">
                    <span class="text-slate-400 font-normal"><%= item.stock_sub_item&.stock_item&.name %></span> 
                    <span class="mx-1">/</span> 
                    <span><%= item.stock_sub_item&.name %></span>
                  </td>
                  <td class="px-6 py-4 text-sm font-black text-slate-900 text-right tabular-nums">
                    <%= item.quantity %>
                  </td>
                  <% if current_user.admin? || is_approver %>
                    <td class="px-6 py-4 text-right text-sm">
                      <%= link_to stock_order_stock_order_item_path(stock_order, item), 
                          data: { turbo_method: :delete, turbo_confirm: "Remove this item from the order?" }, 
                          class: "p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all inline-block",
                          title: "Remove Item" do %>
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                      <% end %>
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <% if stock_order.purpose.present? %>
        <div class="space-y-4 mb-8">
          <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            Purpose / Notes
          </h4>
          <div class="prose prose-slate max-w-none text-slate-700 leading-relaxed bg-slate-50/50 p-6 rounded-2xl border border-slate-100">
            <%= simple_format stock_order.purpose %>
          </div>
        </div>
      <% end %>

      <% if stock_order.order_proof.attached? %>
        <div class="space-y-4 mb-8">
          <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            Order Proof Document
          </h4>
          <div class="bg-slate-50/50 p-4 rounded-2xl border border-slate-100 flex items-center justify-between">
            <span class="text-sm font-bold text-slate-700 truncate"><%= stock_order.order_proof.filename %></span>
            <%= link_to "View / Download Proof", rails_blob_path(stock_order.order_proof, disposition: "preview"), target: "_blank", class: "bg-blue-50 text-blue-600 hover:bg-blue-100 px-4 py-2 rounded-xl text-xs font-bold transition-all" %>
          </div>
        </div>
      <% end %>

      <% if current_user.admin? || (current_user.manager? && stock_order.pending?) %>
        <div class="pt-6 border-t border-slate-100" data-controller="approval-cascade">
          
          <% is_approver_1 = (stock_order.approver_1_id == current_user.id) %>
          <% is_approver_2 = (stock_order.approver_2_id == current_user.id) %>
          <% is_order_manager = (stock_order.manager_id == current_user.id) %>

          <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            <%= is_order_manager && !current_user.admin? ? "Upload Order Proof" : "Manager Approvals & Assignment" %>
          </h4>

          <%= form_with model: stock_order, class: "bg-slate-50 p-6 rounded-2xl border border-slate-100 space-y-4" do |f| %>
            <div class="space-y-4">
              
              <% if is_order_manager && !current_user.admin? %>
                <div>
                  <%= f.label :order_proof, "Order Proof Document", class: "block text-xs font-bold text-slate-700 mb-1" %>
                  <%= f.file_field :order_proof, 
                      class: "w-full rounded-xl border border-slate-200 bg-white p-2.5 text-sm text-slate-700 shadow-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-slate-900 file:text-white hover:file:bg-blue-600 file:cursor-pointer" 
                  %>
                  <% if stock_order.order_proof.attached? %>
                    <p class="text-xs text-emerald-600 font-semibold mt-2">✓ Order proof currently attached</p>
                  <% end %>
                </div>

              <% else %>
                <div>
                  <%= f.label :company_name, "Company Name", class: "block text-xs font-bold text-slate-700 mb-1" %>
                  <%= f.text_field :company_name, 
                      class: "w-full rounded-xl border-none bg-white p-3 text-sm text-slate-700 shadow-sm", 
                      placeholder: "Enter company name..." 
                  %>
                </div>

                <% if is_approver_1 %>
                  <div>
                    <%= f.label :approver_2_id, "Second Approval Manager", class: "block text-xs font-bold text-slate-700 mb-1" %>
                    <%= f.collection_select :approver_2_id, 
                        User.where(manager: true).where.not(id: [stock_order.user_id, stock_order.approver_1_id].compact), 
                        :id, 
                        :name, 
                        { include_blank: "Select Second Approver..." }, 
                        { class: "w-full rounded-xl border-none bg-white p-3 text-sm text-slate-700 shadow-sm" } 
                    %>
                  </div>

                <% elsif is_approver_2 %>
                  <div>
                    <%= f.label :manager_id, "Order Manager (Assigned for Purchase)", class: "block text-xs font-bold text-slate-700 mb-1" %>
                    <%= f.collection_select :manager_id, 
                        User.where(manager: true).where.not(id: stock_order.approver_2_id), 
                        :id, 
                        :name, 
                        { include_blank: "Select Order Manager..." }, 
                        { class: "w-full rounded-xl border-none bg-white p-3 text-sm text-slate-700 shadow-sm" } 
                    %>
                  </div>

                <% elsif current_user.admin? %>
                  <% if stock_order.approver_2_id.blank? %>
                    <div>
                      <%= f.label :approver_2_id, "Second Approval Manager", class: "block text-xs font-bold text-slate-700 mb-1" %>
                      <%= f.collection_select :approver_2_id, 
                          User.where(manager: true).where.not(id: [stock_order.user_id, stock_order.approver_1_id].compact), 
                          :id, 
                          :name, 
                          { include_blank: "Select Second Approver..." }, 
                          { class: "w-full rounded-xl border-none bg-white p-3 text-sm text-slate-700 shadow-sm" } 
                      %>
                    </div>
                  <% else %>
                    <div>
                      <%= f.label :manager_id, "Order Manager (Assigned for Purchase)", class: "block text-xs font-bold text-slate-700 mb-1" %>
                      <%= f.collection_select :manager_id, 
                          User.where(manager: true).where.not(id: stock_order.approver_2_id), 
                          :id, 
                          :name, 
                          { include_blank: "Select Order Manager..." }, 
                          { class: "w-full rounded-xl border-none bg-white p-3 text-sm text-slate-700 shadow-sm" } 
                      %>
                    </div>
                  <% end %>
                <% end %>
              <% end %>
            </div>

            <div class="flex justify-end pt-2">
              <%= f.submit is_order_manager && !current_user.admin? ? "Upload Proof" : "Save Management Details", 
                  class: "bg-slate-900 hover:bg-blue-600 text-white px-6 py-2.5 rounded-xl font-bold text-sm transition-all shadow-md cursor-pointer" 
              %>
            </div>
          <% end %>
        </div>
      <% end %>

      <% if stock_order.in_delivery? && current_user == stock_order.user %>
        <div class="pt-6 border-t border-slate-100">
          <div class="bg-emerald-50 border border-emerald-100 p-6 rounded-2xl flex items-center justify-between flex-wrap gap-4">
            <div>
              <h4 class="text-sm font-bold text-emerald-900">Order is currently out for delivery</h4>
              <p class="text-xs text-emerald-700 mt-0.5">Please click the button once you have received your items.</p>
            </div>

            <%= form_with model: stock_order, class: "inline-block" do |f| %>
              <%= f.hidden_field :status, value: :completed %>
              <%= f.submit "Order Received", 
                  class: "bg-emerald-600 hover:bg-emerald-700 text-white px-6 py-2.5 rounded-xl font-bold text-sm transition-all shadow-md cursor-pointer" 
              %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <div class="w-full md:w-80 bg-slate-50 border-l border-slate-100 p-8 md:p-10">
      <div class="space-y-8">
        <div>
          <label class="block text-[10px] uppercase font-black text-slate-400 tracking-wider mb-2">School</label>
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0z"></path></svg>
            </div>
            <p class="text-slate-900 font-bold leading-tight"><%= stock_order.school&.name %></p>
          </div>
        </div>

        <div>
          <label class="block text-[10px] uppercase font-black text-slate-400 tracking-wider mb-2">Teacher / Contact Details</label>
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center text-indigo-600 shrink-0 mt-0.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"></path>
              </svg>
            </div>
            <div class="space-y-1 text-sm">
              <p class="text-slate-900 font-bold leading-tight"><%= stock_order.user&.name %></p>
              <p class="text-slate-600 font-medium text-xs"><%= stock_order.teacher_phone_number %></p>
              <p class="text-blue-600 font-medium text-xs break-all"><%= stock_order.teacher_email %></p>
            </div>
          </div>
        </div>

        <div class="space-y-4 pt-4 border-t border-slate-200">
          <label class="block text-[10px] uppercase font-black text-slate-400 tracking-wider">Management & Approvals</label>
          
          <div>
            <span class="block text-[9px] uppercase font-bold text-slate-400 mb-0.5">First Approval</span>
            <p class="text-slate-900 font-bold text-xs"><%= stock_order.approver_1&.name || "Not assigned" %></p>
          </div>

          <div>
            <span class="block text-[9px] uppercase font-bold text-slate-400 mb-0.5">Second Approval</span>
            <p class="text-slate-900 font-bold text-xs"><%= stock_order.approver_2&.name || "Not assigned" %></p>
          </div>

          <div>
            <span class="block text-[9px] uppercase font-bold text-slate-400 mb-0.5">Order Manager</span>
            <p class="text-slate-900 font-bold text-xs"><%= stock_order.manager&.name || "Not assigned" %></p>
          </div>
        </div>

        <div class="pt-6 border-t border-slate-200">
          <label class="block text-[10px] uppercase font-black text-slate-400 tracking-wider mb-2">Timeline</label>
          <div class="space-y-1">
            <p class="text-xs text-slate-500">Created <span class="text-slate-900 font-bold"><%= time_ago_in_words(stock_order.created_at) %> ago</span></p>
            <p class="text-[10px] font-mono text-slate-400"><%= stock_order.created_at.strftime("%d %b %Y, %H:%M") %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
