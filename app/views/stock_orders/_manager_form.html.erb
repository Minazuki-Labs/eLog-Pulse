<div class="pt-6 border-t border-slate-100" data-controller="approval-cascade">
  
  <% is_approver_1 = (stock_order.approver_1_id == current_user.id) %>
  <% is_approver_2 = (stock_order.approver_2_id == current_user.id) %>
  <% is_order_manager = (stock_order.manager_id == current_user.id) %>

  <h4 class="text-xs font-bold text-slate-400 uppercase tracking-widest mb-4 flex items-center gap-2">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
    <%= is_order_manager && !current_user.admin? ? "Upload Order Proof" : "Manager Approvals & Assignment" %>
  </h4>

  <%= form_with model: stock_order, data: { turbo_frame: "_top" }, class: "bg-slate-50 p-6 rounded-2xl border border-slate-100 space-y-4" do |f| %>

    <% if stock_order.errors.any? %>
      <div class="bg-red-50 text-red-600 p-4 rounded-xl border border-red-100 mb-4">
        <p class="font-bold text-xs uppercase tracking-wider mb-2">Could not save details:</p>
        <ul class="list-disc ml-4 text-xs space-y-1 font-semibold">
          <% stock_order.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-4">
      
      <% if is_order_manager && !current_user.admin? %>
        <div>
          <%= f.label :order_proof, "Order Proof Document", class: "block text-xs font-bold text-slate-700 mb-1" %>
          <%= f.file_field :order_proof, 
              class: "w-full rounded-xl border border-slate-200 bg-white p-2.5 text-sm text-slate-700 shadow-sm file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-bold file:bg-slate-900 file:text-white hover:file:bg-blue-600 file:cursor-pointer" 
          %>
          <% if stock_order.order_proof.attached? %>
            <p class="text-xs text-emerald-600 font-semibold mt-2">✓ Order proof currently attached</p>
          <% end %>
        </div>

      <% else %>
        <div>
          <%= f.label :company_name, "Company Name", class: "block text-xs font-bold text-slate-700 mb-1" %>
          <%= f.text_field :company_name, 
              class: "w-full rounded-xl border-none bg-white p-3 text-sm text-slate-700 shadow-sm", 
              placeholder: "Enter company name..." 
          %>
        </div>

        <% if is_approver_1 %>
          <div>
            <%= f.label :approver_2_id, "Second Approval Manager", class: "block text-xs font-bold text-slate-700 mb-1" %>
            <%= f.collection_select :approver_2_id, 
                User.where(manager: true).where.not(id: [stock_order.user_id, stock_order.approver_1_id].compact), 
                :id, 
                :name, 
                { include_blank: "Select Second Approver..." }, 
                { 
                  class: "w-full rounded-xl border-none bg-white p-3 text-sm text-slate-700 shadow-sm disabled:bg-slate-100 disabled:text-slate-400 disabled:cursor-not-allowed",
                  disabled: stock_order.approver_2_id.present? && stock_order.errors.none?
                } 
            %>
            <% if stock_order.approver_2_id.present? && stock_order.errors.none? %>
              <%= f.hidden_field :approver_2_id %>
            <% end %>
          </div>

        <% elsif is_approver_2 %>
          <div>
            <%= f.label :manager_id, "Order Manager (Assigned for Purchase)", class: "block text-xs font-bold text-slate-700 mb-1" %>
            <%= f.collection_select :manager_id, 
                User.where(manager: true).where.not(id: stock_order.approver_2_id), 
                :id, 
                :name, 
                { include_blank: "Select Order Manager..." }, 
                { 
                  class: "w-full rounded-xl border-none bg-white p-3 text-sm text-slate-700 shadow-sm disabled:bg-slate-100 disabled:text-slate-400 disabled:cursor-not-allowed",
                  disabled: stock_order.manager_id.present? && stock_order.errors.none?
                } 
            %>
            <% if stock_order.manager_id.present? && stock_order.errors.none? %>
              <%= f.hidden_field :manager_id %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="flex justify-end pt-2">
      <%= f.submit is_order_manager && !current_user.admin? ? "Upload Proof" : "Save Management Details", 
          class: "bg-slate-900 hover:bg-blue-600 text-white px-6 py-2.5 rounded-xl font-bold text-sm transition-all shadow-md cursor-pointer" 
      %>
    </div>
  <% end %>
</div>
