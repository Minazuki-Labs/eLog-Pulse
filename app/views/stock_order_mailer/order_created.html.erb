<table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 20px;">
  <tr>
    <td style="font-size: 15px; color: #1e293b; font-weight: 600;">
      Hi, <%= @requester.name %>,
    </td>
  </tr>
</table>

<table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 24px;">
  <tr>
    <td>
      <h2 style="margin: 0 0 6px 0; font-size: 22px; font-weight: 900; color: #1e293b; letter-spacing: -0.03em;">
        Stock Order Submitted
      </h2>
      <p style="margin: 0; font-size: 14px; color: #64748b; font-weight: 500;">
        Your stock order <strong style="color: #0f172a;">#<%= @stock_order.id %></strong> has been successfully sent to the manager(s) for approval.
      </p>
    </td>
  </tr>
</table>

<!-- Meta Info Card -->
<table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; margin-bottom: 24px;">
  <tr>
    <td style="padding: 20px 24px;">
      <table width="100%" border="0" cellspacing="0" cellpadding="0">
        <tr>
          <td style="padding-bottom: 10px; font-size: 13px; color: #64748b;">
            <strong>Order ID:</strong> <span style="color: #1e293b; font-weight: 600;">#<%= @stock_order.id %></span>
          </td>
        </tr>
        <tr>
          <td style="padding-bottom: 10px; font-size: 13px; color: #64748b;">
            <strong>Status:</strong> 
            <span style="display: inline-block; padding: 3px 10px; font-size: 11px; font-weight: 800; text-transform: uppercase; background-color: #eff6ff; color: #2563eb; border-radius: 9999px;">
              <%= @stock_order.status.humanize %>
            </span>
          </td>
        </tr>
        <tr>
          <td style="padding-bottom: 10px; font-size: 13px; color: #64748b;">
            <strong>School:</strong> <span style="color: #1e293b; font-weight: 600;"><%= @stock_order.school&.name || 'N/A' %></span>
          </td>
        </tr>
        <tr>
          <td style="font-size: 13px; color: #64748b;">
            <strong>Purpose:</strong> <span style="color: #1e293b; font-weight: 600;"><%= @stock_order.purpose.presence || 'N/A' %></span>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>

<!-- Ordered Items Table -->
<h3 style="margin: 0 0 12px 0; font-size: 16px; font-weight: 800; color: #1e293b; letter-spacing: -0.02em;">
  Ordered Items
</h3>

<table width="100%" border="0" cellspacing="0" cellpadding="0" style="border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; margin-bottom: 32px; background-color: #ffffff;">
  <thead>
    <tr style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
      <th align="left" style="padding: 12px 16px; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">Item</th>
      <th align="center" style="padding: 12px 16px; font-size: 12px; font-weight: 700; color: #64748b; text-transform: uppercase;">Quantity</th>
    </tr>
  </thead>
  <tbody>
    <% @stock_order.stock_order_items.includes(:stock_sub_item).each do |item| %>
      <tr style="border-bottom: 1px solid #f1f5f9;">
        <td style="padding: 12px 16px; font-size: 14px; color: #334155; font-weight: 600;">
          <%= item.stock_sub_item&.name %>
        </td>
        <td align="center" style="padding: 12px 16px; font-size: 14px; color: #1e293b; font-weight: 700;">
          <%= item.quantity %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
