<main class="flex-1 p-8 lg:p-12">
  <div class="max-w-3xl mx-auto py-10 px-4">
    
    <div class="flex items-center justify-between mb-6">
      <%= link_to companies_path, class: "group flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors" do %>
        <svg class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
        </svg>
        <span class="font-semibold">Back to Company Directory</span>
      <% end %>

      <div class="flex items-center gap-2">
        <% if current_user.admin? %>
          <%= link_to edit_company_path(@company), 
              class: "p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-xl transition-all", 
              title: "Edit Details" do %>
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
            </svg>
          <% end %>

          <%= link_to company_path(@company), 
              data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this company?" }, 
              class: "p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all", 
              title: "Delete Company" do %>
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
            </svg>
          <% end %>
        <% end %>
      </div>
    </div>

    <div class="bg-white p-8 rounded-2xl border border-slate-200/60 shadow-sm space-y-6">
      <div>
        <span class="text-xs font-bold text-blue-600 uppercase tracking-wider">Company Details</span>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight mt-1"><%= @company.name %></h1>
      </div>
    </div>

  </div>
</main>
