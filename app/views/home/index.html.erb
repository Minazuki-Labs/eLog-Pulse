<main class="flex-1 p-8 lg:p-12">
  <div class="max-w-5xl mx-auto">
    <div class="flex justify-between items-center mb-10">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Support Tickets</h1>
        <p class="text-slate-400 mt-1 text-base">Manage and track your recent activity.</p>
      </div>
      
      <%= link_to new_ticket_path, class: "inline-flex items-center px-5 py-3 bg-blue-600 text-white text-sm font-bold rounded-xl shadow-md shadow-blue-100 hover:bg-blue-700 transition-all" do %>
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
        New Ticket
      <% end %>
    </div>

    <% if current_user.school? %>
      <div class="space-y-6">
        <% [
          { name: "New Case", color: "bg-yellow-400", scope: :new_case? },
          { name: "In Progress", color: "bg-blue-500", scope: :in_progress? },
        ].each do |status| %>
          <%= render "status_section", 
                     name: status[:name], 
                     color: status[:color], 
                     tickets: @tickets.select(&status[:scope]) %>
        <% end %>
      </div>
    <% else %>
      <div class="space-y-4">
        <% if @states_data.blank? %>
          <div class="bg-white rounded-2xl p-8 text-center border border-slate-200/60 text-slate-400">
            No incomplete tickets found.
          </div>
        <% else %>
          <% @states_data.each do |state_group| %>
            <% state_name = state_group[:state] %>
            <% total_state_tickets = state_group[:schools].sum { |s| s[:tickets].count } %>

            <details name="states-accordion" class="border border-slate-200 rounded-2xl bg-white shadow-sm overflow-hidden transition-all">
              <summary class="flex items-center justify-between w-full p-5 cursor-pointer bg-slate-50/50 hover:bg-slate-100/80 transition-colors select-none">                <div class="flex items-center">
                  <span class="w-3 h-3 bg-indigo-500 rounded-full mr-3"></span>
                  <h2 class="text-lg font-bold text-slate-700"><%= state_name.titleize %></h2>
                  <span class="ml-3 text-xs font-medium text-slate-400 bg-slate-200/70 px-2.5 py-0.5 rounded-full">
                    <%= total_state_tickets %> tickets
                  </span>
                </div>
                
                <svg class="w-5 h-5 text-slate-400 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                </svg>
              </summary>

              <div class="p-5 space-y-4 border-t border-slate-100 bg-slate-50/30">
                <% state_group[:schools].each do |school_group| %>
                  <% school = school_group[:school] %>
                  <% school_tickets = school_group[:tickets] %>

                  <details name="schools-accordion-<%= state_name.parameterize %>" class="border border-slate-200/80 rounded-xl bg-white shadow-sm overflow-hidden transition-all">
                    <summary class="flex items-center justify-between w-full p-4 cursor-pointer bg-white hover:bg-slate-50 transition-colors select-none">
                      <div class="flex items-center">
                        <div class="h-7 w-7 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 mr-3">
                          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-7h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path></svg>
                        </div>
                        <h3 class="text-base font-bold text-slate-700 uppercase"><%= school.name %></h3>
                        <span class="ml-3 text-xs font-medium text-slate-400 bg-slate-100 px-2 py-0.5 rounded-full">
                          <%= school_tickets.count %>
                        </span>
                      </div>

                      <svg class="w-4 h-4 text-slate-400 transition-transform duration-200 group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                      </svg>
                    </summary>

                    <div class="p-5 border-t border-slate-100 bg-slate-50/50 space-y-6">
                      <% [
                        { name: "New Case", color: "bg-yellow-400", scope: :new_case? },
                        { name: "In Progress", color: "bg-blue-500", scope: :in_progress? },
                      ].each do |status| %>
                        <% filtered_tickets = school_tickets.select(&status[:scope]) %>
                        <% next if filtered_tickets.empty? %>
                        
                        <div>
                          <div class="flex items-center mb-3">
                            <span class="w-2.5 h-2.5 <%= status[:color] %> rounded-full mr-2"></span>
                            <h4 class="text-sm font-bold text-slate-700"><%= status[:name] %></h4>
                            <span class="ml-2 text-xs font-medium text-slate-400 bg-slate-200/70 px-2 py-0.5 rounded-full">
                              <%= filtered_tickets.count %>
                            </span>
                          </div>

                          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                            <%= render partial: "home/ticket_card", collection: filtered_tickets, as: :ticket, locals: { show_school: false } %>
                          </div>
                        </div>
                      <% end %>
                    </div>
                  </details>
                <% end %>
              </div>
            </details>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</main>
