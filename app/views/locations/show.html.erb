<main class="flex-1 p-8 lg:p-12 bg-slate-50/30 min-h-screen">
  <div class="max-w-5xl mx-auto">
    
    <div class="flex items-center justify-between mb-8 pb-4 border-b border-slate-100">
      <div class="flex items-center gap-4">
        <%= link_to user_locations_path(@school), class: "group p-2.5 bg-white hover:bg-slate-50 text-slate-500 hover:text-blue-600 rounded-xl border border-slate-200/60 shadow-sm transition-all", title: "Back to Locations" do %>
          <svg class="w-5 h-5 transform group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
          </svg>
        <% end %>
        <div>
          <h1 class="text-3xl font-black text-slate-900 tracking-tight"><%= @location.name %></h1>
          <p class="text-slate-400 mt-0.5 text-xs font-bold uppercase tracking-wider"><%= @school.name %> — Location Details</p>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <%= link_to edit_user_location_path(@school, @location), 
            class: "p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-xl transition-all", 
            title: "Edit Location" do %>
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        <% end %>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
      
      <div class="lg:col-span-2 space-y-6">
        <div class="bg-slate-50 rounded-[2rem] border border-slate-200/60 p-8 flex flex-col justify-between">
          <div>
            <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest mb-6 flex items-center gap-2">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
              </svg>
              Equipment Setup
            </h3>

            <%= form_with url: update_equipment_user_location_path(@school, @location), method: :patch, local: true, class: "space-y-4" do |f| %>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 max-h-[400px] overflow-y-auto pr-1">
                <% assigned_cat_ids = @equipment.pluck(:equipment_category_id) %>
                <% @equipment_categories.each do |category| %>
                  <label class="flex items-center gap-3 p-3 bg-white rounded-xl border border-slate-200/60 shadow-sm cursor-pointer hover:border-blue-300 transition-all">
                    <%= check_box_tag "equipment_category_ids[]", category.id, assigned_cat_ids.include?(category.id), class: "rounded border-slate-300 text-blue-600 focus:ring-blue-500 w-4 h-4" %>
                    <span class="text-sm font-bold text-slate-700"><%= category.name %></span>
                  </label>
                <% end %>
              </div>

              <div class="pt-4">
                <%= f.submit "Save Equipment Changes", class: "w-full sm:w-auto text-center py-2.5 px-6 bg-slate-900 text-white font-bold text-xs rounded-xl hover:bg-blue-600 transition-all shadow-lg shadow-slate-900/10 cursor-pointer" %>
              </div>
            <% end %>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100">
            <div class="flex justify-between text-xs text-slate-400 font-semibold">
              <span>Total Items Assigned:</span>
              <span class="font-black text-slate-800"><%= @equipment.count %></span>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-white rounded-[2rem] shadow-xl shadow-slate-200/40 border border-slate-100 p-8">
          
          <div class="flex items-center justify-between mb-6">
            <h3 class="text-xs font-black text-slate-400 uppercase tracking-widest flex items-center gap-2">
              <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
              Active Tickets
            </h3>
            <span class="px-3 py-1 rounded-full bg-blue-50 text-blue-600 text-xs font-black ring-1 ring-inset ring-blue-200/50">
              <%= @tickets.count %>
            </span>
          </div>

          <% if @tickets.any? %>
            <div class="space-y-3">
              <% @tickets.sort_by { |t| Ticket.statuses[t.status] || 0 }.each do |ticket| %>
                <%= link_to ticket, class: "flex flex-col p-4 bg-slate-50/50 hover:bg-white border border-slate-200/60 hover:border-blue-200 rounded-2xl hover:shadow-lg hover:shadow-slate-100/80 transition-all gap-3 group" do %>
                  <div class="flex items-center justify-between">
                    <span class="px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider text-center shadow-sm <%= status_color(ticket.status) %>">
                      <%= ticket.status.humanize %>
                    </span>
                    <span class="text-[11px] font-semibold text-slate-400 tabular-nums">
                      <%= ticket.created_at.strftime("%d %b %Y") %>
                    </span>
                  </div>
                  
                  <div>
                    <h4 class="text-sm font-bold text-slate-800 group-hover:text-blue-600 transition-colors">
                      <%= ticket.equipment&.equipment_category&.name || "Equipment" %>
                    </h4>
                    <p class="text-xs text-slate-500 mt-0.5 font-medium"><%= ticket.issue_type&.name %></p>
                    <p class="text-slate-400 text-xs mt-1 line-clamp-2">
                      <%= ticket.description %>
                    </p>
                  </div>
                <% end %>
              <% end %>
            </div>
          <% else %>
            <div class="text-center py-12 bg-slate-50/50 rounded-2xl border border-dashed border-slate-200">
              <p class="text-slate-400 text-sm italic">No active tickets for this location.</p>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </div>
</main>
