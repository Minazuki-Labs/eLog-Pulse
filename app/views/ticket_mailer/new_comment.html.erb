<div>
  <!-- Greeting -->
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 20px;">
    <tr>
      <td style="font-size: 15px; color: #1e293b; font-weight: 600;">
        Hi, <%= @ticket.teacher_name %>,
      </td>
    </tr>
  </table>

  <!-- Title & Status Header -->
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 24px;">
    <tr>
      <td>
        <h2 style="margin: 0 0 6px 0; font-size: 22px; font-weight: 900; color: #1e293b; letter-spacing: -0.03em;">
          Ticket Update Notification
        </h2>
        <p style="margin: 0; font-size: 14px; color: #64748b; font-weight: 500;">
          New activity has been posted on ticket <strong style="color: #0f172a;">#<%= @ticket.id %></strong>
        </p>
      </td>
    </tr>
  </table>

  <!-- Meta Info Card -->
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-radius: 16px; margin-bottom: 32px;">
    <tr>
      <td style="padding: 20px 24px;">
        <table width="100%" border="0" cellspacing="0" cellpadding="0">
          <tr>
            <td style="padding-bottom: 10px; font-size: 13px; color: #64748b;">
              <strong>Case ID:</strong> <span style="color: #1e293b; font-weight: 600;">#<%= @ticket.id %></span>
            </td>
          </tr>
          <tr>
            <td style="padding-bottom: 10px; font-size: 13px; color: #64748b;">
              <strong>Status:</strong> 
              <span style="display: inline-block; padding: 3px 10px; font-size: 11px; font-weight: 800; text-transform: uppercase; background-color: #eff6ff; color: #2563eb; border-radius: 9999px; letter-spacing: 0.025em;">
                <%= @ticket.status.humanize %>
              </span>
            </td>
          </tr>
          <tr>
            <td style="font-size: 13px; color: #64748b;">
              <strong>School:</strong> <span style="color: #1e293b; font-weight: 600;"><%= @school&.name %></span>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

  <!-- Section Heading -->
  <h3 style="margin: 0 0 16px 0; font-size: 16px; font-weight: 800; color: #1e293b; border-bottom: 2px solid #f1f5f9; padding-bottom: 10px; letter-spacing: -0.02em;">
    Log History
  </h3>

  <!-- Comments / Logs Loop -->
  <% @comments.each do |c| %>
    <table width="100%" border="0" cellspacing="0" cellpadding="0" style="border: 1px solid #e2e8f0; border-radius: 16px; margin-bottom: 16px; background-color: #ffffff;">
      <tr>
        <td style="padding: 20px;">
          <!-- Comment Header -->
          <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-bottom: 10px;">
            <tr>
              <td style="font-size: 12px; color: #64748b;">
                <strong style="color: #1e293b;">By:</strong> <%= c.user&.name || 'System / Unknown' %> &nbsp;|&nbsp; 
                <strong style="color: #1e293b;">Jobsheet:</strong> <%= c.jobsheet.presence || 'N/A' %>
              </td>
              <td align="right" style="font-size: 12px; color: #94a3b8; font-weight: 500;">
                <%= c.created_at.strftime("%b %d, %Y %H:%M") %>
              </td>
            </tr>
          </table>
          <!-- Comment Body -->
          <div style="font-size: 14px; color: #334155; line-height: 1.6; white-space: pre-wrap; border-top: 1px solid #f1f5f9; padding-top: 12px;"><%= c.body %></div>
        </td>
      </tr>
    </table>
  <% end %>

  <!-- Closing & Company Sign-off -->
  <table width="100%" border="0" cellspacing="0" cellpadding="0" style="margin-top: 32px; border-top: 1px solid #f1f5f9; padding-top: 24px;">
    <tr>
      <td style="font-size: 14px; color: #334155; line-height: 1.6;">
        <p style="margin: 0 0 16px 0;">
          If you have any further questions then do let us know.
        </p>
        <p style="margin: 0 0 16px 0;">
          Thanks and regards,
        </p>
        <p style="margin: 0; font-size: 13px; color: #64748b; line-height: 1.5;">
          <strong style="color: #1e293b; display: block; margin-bottom: 2px;">DIGITAL IT SOLUTIONS SDN BHD (DITS)</strong>
          No.10, Jalan 15/22,<br>
          Tiong Nam Industrial Park,<br>
          Section 15, 40200 Shah Alam, Malaysia.<br>
          Tel: <a href="tel:+60355231781" style="color: #2563eb; text-decoration: none;">+60 3 5523 1781</a>
        </p>
      </td>
    </tr>
  </table>
</div>
