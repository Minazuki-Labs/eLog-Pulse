<%= link_to user_path(employee), class: "group relative bg-white rounded-2xl p-5 border border-slate-200/60 shadow-sm hover:shadow-xl hover:shadow-blue-500/5 hover:-translate-y-0.5 transition-all duration-300 flex flex-col sm:flex-row sm:items-center justify-between gap-4 overflow-hidden block" do %>

  <div class="flex items-center gap-4 min-w-0">
    <div class="h-11 w-11 shrink-0 rounded-xl bg-blue-50 text-blue-600 font-bold text-xs flex items-center justify-center tracking-wider group-hover:bg-blue-600 group-hover:text-white transition-all duration-300">
      <%= employee.initials %>
    </div>
    
    <div class="min-w-0 flex-1">
      <h3 class="text-lg font-extrabold text-slate-800 group-hover:text-blue-600 transition-colors leading-snug truncate">
        <%= employee.name %>
      </h3>
      <p class="text-slate-400 text-sm font-medium tracking-tight truncate mt-0.5">
        <%= employee.username %>
      </p>
    </div>
  </div>

  <div class="flex items-center justify-between sm:justify-end gap-4 border-t sm:border-t-0 pt-3 sm:pt-0 border-slate-100">
    <span class="inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-semibold bg-slate-100 text-slate-600 group-hover:bg-blue-50 group-hover:text-blue-600 transition-colors">
      <%= employee.assigned_schools.count %> Schools Assigned
    </span>

    <div class="p-2.5 rounded-xl bg-slate-50 text-slate-600 group-hover:bg-blue-50 group-hover:text-blue-600 transition-all">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
      </svg>
    </div>
  </div>

  <div class="absolute inset-y-0 left-0 w-1 bg-gradient-to-b from-blue-500 to-indigo-600 scale-y-0 group-hover:scale-y-100 transition-transform origin-top duration-300"></div>

<% end %>