<div class="bg-white rounded-[2.5rem] p-8 md:p-12 shadow-xl shadow-slate-200/40 border border-slate-100">
  <%= form_with(model: user, url: user_path(user), data: { controller: "role-warning" }, method: :patch, class: "space-y-8") do |f| %>

    <% if user.errors.any? %>
      <div class="bg-red-50 text-red-600 p-4 rounded-2xl mb-6 border border-red-100">
        <p class="font-black mb-2">Please correct the following:</p>
        <ul class="list-disc ml-5 space-y-1">
          <% user.errors.full_messages.each do |message| %>
            <li class="font-medium"><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="space-y-6">
      <!-- Name Field -->
      <div>
        <%= f.label :name, user.school? ? "School Name" : "Employee Name", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5 ml-1" %>
        <%= f.text_field :name, 
            placeholder: user.school? ? "Enter school name" : "Enter employee name",
            required: true,
            class: "block w-full px-4 py-3.5 border-2 #{ user.errors[:name].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all text-slate-700" %>
      </div>

      <!-- Username / School Code Field -->
      <div>
        <%= f.label :username, user.school? ? "School Code" : "Username", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5 ml-1" %>
        <%= f.text_field :username, 
            placeholder: user.school? ? "Enter school code" : "Enter username",
            required: true,
            class: "block w-full px-4 py-3.5 border-2 #{ user.errors[:username].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all text-slate-700" %>
      </div>

      <!-- User Type Selection Field  -->
      <% unless user.school? %>
        <div class="space-y-3">
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider ml-1">
            Staff Roles & Permissions
          </label>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
            <label class="relative flex items-center justify-between p-4 rounded-2xl border-2 transition-all cursor-pointer bg-slate-50/50 border-slate-200/80 hover:border-slate-300 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/30 has-[:checked]:shadow-sm">
              <div class="flex items-center gap-3">
                <%= f.check_box :role, { 
                  checked: user.contractor?, 
                  data: { 
                    role_warning_target: "contractorCheckbox",
                    was_contractor: user.contractor?,
                    action: "change->role-warning#confirmChange" 
                  }, 
                  class: "w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 focus:ring-offset-0 cursor-pointer" 
                }, "contractor", "employee" %>
                <div class="flex items-center gap-1.5">
                  <span class="text-sm font-semibold text-slate-800">Contractor</span>
                  
                  <div class="group relative flex items-center">
                    <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block whitespace-nowrap px-3 py-1.5 bg-slate-900 text-white text-xs font-medium rounded-xl shadow-xl z-20 pointer-events-none transition-all">
                      Only can see school assign to them.
                      <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900"></div>
                    </div>
                  </div>
                </div>
              </div>
            </label>

            <label class="relative flex items-center justify-between p-4 rounded-2xl border-2 transition-all cursor-pointer bg-slate-50/50 border-slate-200/80 hover:border-slate-300 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/30 has-[:checked]:shadow-sm">
              <div class="flex items-center gap-3">
                <%= f.check_box :manager, { class: "w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 focus:ring-offset-0 cursor-pointer" } %>
                <div class="flex items-center gap-1.5">
                  <span class="text-sm font-semibold text-slate-800">Manager</span>
                  
                  <div class="group relative flex items-center">
                    <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block whitespace-nowrap px-3 py-1.5 bg-slate-900 text-white text-xs font-medium rounded-xl shadow-xl z-20 pointer-events-none transition-all">
                      Can approve stock order.
                      <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900"></div>
                    </div>
                  </div>
                </div>
              </div>
            </label>

            <label class="relative flex items-center justify-between p-4 rounded-2xl border-2 transition-all cursor-pointer bg-slate-50/50 border-slate-200/80 hover:border-slate-300 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/30 has-[:checked]:shadow-sm">
              <div class="flex items-center gap-3">
                <%= f.check_box :teacher, { class: "w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 focus:ring-offset-0 cursor-pointer" } %>
                <div class="flex items-center gap-1.5">
                  <span class="text-sm font-semibold text-slate-800">Teacher</span>
                  
                  <div class="group relative flex items-center">
                    <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block whitespace-nowrap px-3 py-1.5 bg-slate-900 text-white text-xs font-medium rounded-xl shadow-xl z-20 pointer-events-none transition-all">
                      Can create stock order.
                      <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900"></div>
                    </div>
                  </div>
                </div>
              </div>
            </label>

            <label class="relative flex items-center justify-between p-4 rounded-2xl border-2 transition-all cursor-pointer bg-slate-50/50 border-slate-200/80 hover:border-slate-300 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/30 has-[:checked]:shadow-sm">
              <div class="flex items-center gap-3">
                <%= f.check_box :admin, { class: "w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 focus:ring-offset-0 cursor-pointer" } %>
                <div class="flex items-center gap-1.5">
                  <span class="text-sm font-semibold text-slate-800">Admin</span>
                  
                  <div class="group relative flex items-center">
                    <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block whitespace-nowrap px-3 py-1.5 bg-slate-900 text-white text-xs font-medium rounded-xl shadow-xl z-20 pointer-events-none transition-all">
                      Full system administration privileges.
                      <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900"></div>
                    </div>
                  </div>
                </div>
              </div>
            </label>
          </div>
        </div>
      <% end %>

      <% if user.school? %>
        <!-- State Selection Field -->
        <div>
          <%= f.label :state, "State", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5 ml-1" %>
          <%= f.select :state, User.states.keys.map { |s| [s.humanize, s] }, { prompt: "Select State" }, 
              class: "block w-full px-4 py-3.5 border-2 #{ user.errors[:state].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all text-slate-700" %>
        </div>

        <!-- School Emails Dynamic Section -->
        <div class="space-y-3" data-controller="email-fields" data-email-fields-max-value="3">
          <div class="flex items-center justify-between ml-1">
            <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">School Emails (Maximum 3)</label>
            <button type="button" data-action="click->email-fields#add" class="text-xs font-bold text-blue-600 hover:text-blue-700 cursor-pointer">
              + Add Another Email
            </button>
          </div>

          <div data-email-fields-target="container" class="space-y-2.5">
            <% emails_to_render = user.school_emails.empty? ? [user.school_emails.build] : user.school_emails %>
            
            <%= f.fields_for :school_emails, emails_to_render do |builder| %>
              <div class="email-group flex items-center gap-2">
                <%= builder.email_field :email, placeholder: "school@example.com", 
                    class: "flex-1 block w-full px-4 py-3.5 border-2 #{ builder.object.errors[:email].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all text-slate-700" %>
                <button type="button" data-action="click->email-fields#remove" class="remove-btn px-3 py-3.5 text-slate-400 hover:text-red-600 font-bold text-sm transition-colors cursor-pointer" title="Remove Email">
                  ✕
                </button>
              </div>
            <% end %>
          </div>

          <template data-email-fields-target="template">
            <div class="email-group flex items-center gap-2">
              <%= f.fields_for :school_emails, SchoolEmail.new, child_index: "TEMPLATE_RECORD" do |builder| %>
                <%= builder.email_field :email, placeholder: "school@example.com", 
                    class: "flex-1 block w-full px-4 py-3.5 border-2 border-slate-100 bg-slate-50 rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all text-slate-700" %>
              <% end %>
              <button type="button" data-action="click->email-fields#remove" class="remove-btn px-3 py-3.5 text-slate-400 hover:text-red-600 font-bold text-sm transition-colors cursor-pointer" title="Remove Email">
                ✕
              </button>
            </div>
          </template>
        </div>
      <% end %>

      <!-- Password Management Section -->
      <div data-controller="password-generator" class="border-t border-slate-100 pt-6 mt-6">
        <div class="flex items-center justify-between mb-2 ml-1">
          <label class="text-xs font-bold text-slate-500 uppercase tracking-wider">Password Management</label>
          <button type="button" data-action="click->password-generator#generate" class="text-xs font-bold text-blue-600 hover:text-blue-700 cursor-pointer">
            Generate Password
          </button>
        </div>
        <p class="text-xs text-slate-400 ml-1 mb-3">Leave blank if you do not want to change the current password.</p>
        
        <%= f.password_field :password, data: { password_generator_target: "input" }, placeholder: "••••••••", 
            class: "block w-full px-4 py-3.5 border-2 #{ user.errors[:password].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all text-slate-700 placeholder:text-slate-400" %>
        <%= f.hidden_field :password_confirmation, data: { password_generator_target: "confirmation" } %>

        <div data-password-generator-target="display" class="bg-blue-50/80 border border-blue-100 p-4 rounded-2xl mt-3 hidden space-y-1">
          <p class="text-xs font-bold text-blue-900 tracking-wide uppercase">New Password Generated:</p>
          <p class="text-sm font-mono font-bold text-blue-950 select-all" data-password-generator-target="plainView"></p>
          <p class="text-xs text-blue-700 pt-1">Make sure to copy this password. It will not be shown again.</p>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-end gap-3 pt-4">
      <%= link_to "Cancel", user_path(user), class: "px-5 py-3.5 text-sm font-bold text-slate-500 hover:bg-slate-50 rounded-2xl transition-all" %>
      <%= f.submit button_label, 
          class: "px-6 py-3.5 bg-blue-600 text-white text-sm font-bold rounded-2xl shadow-md shadow-blue-100 hover:bg-blue-700 transition-all cursor-pointer" %>
    </div>
  <% end %>
</div>
