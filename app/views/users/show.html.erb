<div class="max-w-5xl mx-auto py-10 px-4">
  
  <% # Top Navigation & Actions Bar %>
  <div class="flex items-center justify-between mb-6">
    <% back_path = if current_user.school?
                     tickets_path
                   elsif @user.staff?
                     employees_users_path
                   else
                     schools_users_path
                   end %>

    <%= link_to back_path, class: "group flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors" do %>
      <svg class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      <span class="font-semibold">Back to Directory</span>
    <% end %>

    <div class="flex items-center gap-2">
      <% if current_user.admin? %>
        <% if @user.staff? && current_user != @user %>
          <!-- Toggle Teacher Button -->
          <%= button_to toggle_teacher_user_path(@user), method: :patch, 
              class: "p-2 rounded-xl transition-all #{@user.respond_to?(:teacher?) && @user.teacher? ? 'text-emerald-500 hover:text-emerald-700 hover:bg-emerald-50' : 'text-rose-400 hover:text-rose-600 hover:bg-rose-50'}",
              title: @user.respond_to?(:teacher?) && @user.teacher? ? "Demote Teacher" : "Make Teacher" do %>
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5z M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
            </svg>
          <% end %>

          <!-- Toggle Manager Button -->
          <%= button_to toggle_manager_user_path(@user), method: :patch, 
              class: "p-2 rounded-xl transition-all #{@user.respond_to?(:manager?) && @user.manager? ? 'text-emerald-500 hover:text-emerald-700 hover:bg-emerald-50' : 'text-rose-400 hover:text-rose-600 hover:bg-rose-50'}",
              title: @user.respond_to?(:manager?) && @user.manager? ? "Demote Manager" : "Make Manager" do %>
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
          <% end %>

          <!-- Toggle Admin Button -->
          <%= button_to toggle_admin_user_path(@user), method: :patch, 
              class: "p-2 rounded-xl transition-all #{@user.admin? ? 'text-emerald-500 hover:text-emerald-700 hover:bg-emerald-50' : 'text-rose-400 hover:text-rose-600 hover:bg-rose-50'}",
              title: @user.admin? ? "Demote to Employee" : "Make Admin" do %>
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          <% end %>
        <% end %>

        <!-- Edit Button -->
        <%= link_to edit_user_path(@user), 
            class: "p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-xl transition-all", 
            title: "Edit Details" do %>
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
          </svg>
        <% end %>

        <!-- Delete User Button -->
        <% if current_user != @user %>
          <%= button_to user_path(@user), method: :delete, 
              class: "p-2 text-slate-400 hover:text-red-600 hover:bg-red-50 rounded-xl transition-all", 
              title: "Delete User",
              data: { turbo_confirm: "Are you sure you want to delete this user? This action cannot be undone." } do %>
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2.000 2.000 0 0116.138 21H7.862a2.000 2.000 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          <% end %>
        <% end %>
      <% end %>
    </div>
  </div>

  <% if @user.school? %>
    <%= render "school_profile", school: @school %>
  <% elsif @user.staff? %>
    <%= render "employee_profile", employee: @employee %>
  <% end %>
</div>

<% if @user.school? %>
  <%= render "ticket_history", school: @school %>
<% end %>
