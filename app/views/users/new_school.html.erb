<main class="flex-1 p-8 lg:p-12">
  <div class="max-w-xl mx-auto bg-white p-8 lg:p-10 rounded-2xl border border-slate-200 shadow-sm" data-controller="password-generator">
    <div class="mb-6">
      <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight mb-2">Register New School</h1>
      <p class="text-slate-400 text-sm">Fill out the details below to invite and create a new partner school account.</p>
    </div>

    <%= form_with model: @school, url: create_school_users_path, local: true, class: "space-y-5" do |f| %>
      <% if @school.errors.any? %>
        <div class="bg-red-50 text-red-600 p-4 rounded-2xl text-sm font-medium border border-red-100">
          <ul class="list-disc pl-4 space-y-1">
            <% @school.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "School Name", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5" %>
        <%= f.text_field :name, class: "block w-full px-4 py-3.5 border-2 #{ @school.errors[:name].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all" %>
      </div>

      <div>
        <%= f.label :username, "School Code", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5" %>
        <%= f.text_field :username, class: "block w-full px-4 py-3.5 border-2 #{ @school.errors[:username].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all" %>
      </div>

      <div>
        <%= f.label :state, "State", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5" %>
        <%= f.select :state, User.states.keys.map { |s| [s.humanize, s] }, { prompt: "Select State" }, class: "block w-full px-4 py-3.5 border-2 #{ @school.errors[:state].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all" %>
      </div>

      <div class="space-y-3" data-controller="email-fields" data-email-fields-max-value="3">
        <div class="flex items-center justify-between">
          <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider">School Emails (Maximum 3)</label>
          <button type="button" data-action="click->email-fields#add" class="text-xs font-bold text-blue-600 hover:text-blue-700 cursor-pointer">
            + Add Another Email
          </button>
        </div>

        <div data-email-fields-target="container" class="space-y-2.5">
          <% emails_to_render = @school.school_emails.empty? ? [@school.school_emails.build] : @school.school_emails %>
          
          <%= f.fields_for :school_emails, emails_to_render do |builder| %>
            <div class="email-group flex items-center gap-2">
              <%= builder.email_field :email, placeholder: "school@example.com", class: "flex-1 block w-full px-4 py-3.5 border-2 #{ builder.object.errors[:email].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all" %>
              <button type="button" data-action="click->email-fields#remove" class="remove-btn px-3 py-3.5 text-slate-400 hover:text-red-600 font-bold text-sm transition-colors cursor-pointer" title="Remove Email">
                ✕
              </button>
            </div>
          <% end %>
        </div>

        <template data-email-fields-target="template">
          <div class="email-group flex items-center gap-2">
            <%= f.fields_for :school_emails, SchoolEmail.new, child_index: "TEMPLATE_RECORD" do |builder| %>
              <%= builder.email_field :email, placeholder: "school@example.com", class: "flex-1 block w-full px-4 py-3.5 border-2 border-slate-100 bg-slate-50 rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all" %>
            <% end %>
            <button type="button" data-action="click->email-fields#remove" class="remove-btn px-3 py-3.5 text-slate-400 hover:text-red-600 font-bold text-sm transition-colors cursor-pointer" title="Remove Email">
              ✕
            </button>
          </div>
        </template>
      </div>

      <div>
        <div class="flex items-center justify-between mb-1.5">
          <%= f.label :password, "Password", class: "block text-xs font-bold text-slate-500 uppercase tracking-wider" %>
          <button type="button" data-action="click->password-generator#generate" class="text-xs font-bold text-blue-600 hover:text-blue-700 cursor-pointer">
            Generate Password
          </button>
        </div>
        <%= f.password_field :password, data: { password_generator_target: "input" }, class: "block w-full px-4 py-3.5 border-2 #{ @school.errors[:password].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all" %>
        <%= f.hidden_field :password_confirmation, data: { password_generator_target: "confirmation" } %>
        
        <div data-password-generator-target="display" class="bg-blue-50/80 border border-blue-100 p-4 rounded-2xl mt-3 hidden space-y-1">
          <p class="text-xs font-bold text-blue-900 tracking-wide uppercase">New Password Generated:</p>
          <p class="text-sm font-mono font-bold text-blue-950 select-all" data-password-generator-target="plainView"></p>
          <p class="text-xs text-blue-700 pt-1">Make sure to copy this password. It will not be shown again.</p>
        </div>
      </div>

      <div class="pt-2">
        <%= f.submit "Create School Account", class: "w-full py-3 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-colors shadow-md shadow-blue-100 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</main>
