<div class="max-w-5xl mx-auto py-10 px-4">
  <div class="flex items-center justify-between mb-8">
    <%= link_to user_path(@user), class: "group flex items-center gap-2 text-slate-500 hover:text-blue-600 transition-colors" do %>
      <svg class="w-5 h-5 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      <span class="font-semibold">Back to Details</span>
    <% end %>
    <h1 class="text-3xl font-black text-slate-900 tracking-tight">
      <%= @user.school? ? "Edit School" : "Edit Employee" %>
    </h1>
  </div>

  <% if @user.school? %>
    <%= render "form", user: @school, button_label: "Update School" %>
  <% elsif @user.staff? %>
    <%= render "form", user: @employee, button_label: "Update Employee" %>
  <% end %>
</div>
