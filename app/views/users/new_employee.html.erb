<main class="flex-1 p-8 lg:p-12">
  <div class="max-w-2xl mx-auto bg-white rounded-3xl p-8 border border-slate-100 shadow-sm">
    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight mb-2">Register New Staff</h1>
    <p class="text-slate-400 text-sm mb-8">Fill in the details to add a new staff to the system.</p>

    <%= form_with model: @employee, url: create_employee_users_path, local: true, class: "space-y-6" do |f| %>
      <% if @employee.errors.any? %>
        <div class="bg-red-50 text-red-600 p-4 rounded-2xl text-sm font-medium">
          <ul class="list-disc pl-4 space-y-1">
            <% @employee.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" %>
        <%= f.text_field :name, class: "block w-full px-4 py-3.5 border-2 #{ @employee.errors[:name].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all" %>
      </div>

      <div>
        <%= f.label :username, class: "block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2" %>
        <%= f.text_field :username, class: "block w-full px-4 py-3.5 border-2 #{ @employee.errors[:username].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all" %>
      </div>

      <div class="space-y-3">
        <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">
          Staff Roles & Permissions
        </label>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <label class="relative flex items-center justify-between p-4 rounded-2xl border-2 transition-all cursor-pointer bg-slate-50/50 border-slate-200/80 hover:border-slate-300 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/30 has-[:checked]:shadow-sm">
            <div class="flex items-center gap-3">
              <%= f.check_box :role, { checked: @employee.contractor?, class: "w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 focus:ring-offset-0 cursor-pointer" }, "contractor", "employee" %>
              <div class="flex items-center gap-1.5">
                <span class="text-sm font-semibold text-slate-800">Contractor</span>
                
                <div class="group relative flex items-center">
                  <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block whitespace-nowrap px-3 py-1.5 bg-slate-900 text-white text-xs font-medium rounded-xl shadow-xl z-20 pointer-events-none transition-all">
                    Only can see school assign to them.
                    <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900"></div>
                  </div>
                </div>
              </div>
            </div>
          </label>

          <label class="relative flex items-center justify-between p-4 rounded-2xl border-2 transition-all cursor-pointer bg-slate-50/50 border-slate-200/80 hover:border-slate-300 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/30 has-[:checked]:shadow-sm">
            <div class="flex items-center gap-3">
              <%= f.check_box :manager, { class: "w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 focus:ring-offset-0 cursor-pointer" } %>
              <div class="flex items-center gap-1.5">
                <span class="text-sm font-semibold text-slate-800">Manager</span>
                
                <div class="group relative flex items-center">
                  <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block whitespace-nowrap px-3 py-1.5 bg-slate-900 text-white text-xs font-medium rounded-xl shadow-xl z-20 pointer-events-none transition-all">
                    Can approve stock order.
                    <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900"></div>
                  </div>
                </div>
              </div>
            </div>
          </label>

          <label class="relative flex items-center justify-between p-4 rounded-2xl border-2 transition-all cursor-pointer bg-slate-50/50 border-slate-200/80 hover:border-slate-300 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/30 has-[:checked]:shadow-sm">
            <div class="flex items-center gap-3">
              <%= f.check_box :teacher, { class: "w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 focus:ring-offset-0 cursor-pointer" } %>
              <div class="flex items-center gap-1.5">
                <span class="text-sm font-semibold text-slate-800">Teacher</span>
                
                <div class="group relative flex items-center">
                  <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block whitespace-nowrap px-3 py-1.5 bg-slate-900 text-white text-xs font-medium rounded-xl shadow-xl z-20 pointer-events-none transition-all">
                    Can create stock order.
                    <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900"></div>
                  </div>
                </div>
              </div>
            </div>
          </label>

          <label class="relative flex items-center justify-between p-4 rounded-2xl border-2 transition-all cursor-pointer bg-slate-50/50 border-slate-200/80 hover:border-slate-300 has-[:checked]:border-blue-600 has-[:checked]:bg-blue-50/30 has-[:checked]:shadow-sm">
            <div class="flex items-center gap-3">
              <%= f.check_box :admin, { class: "w-4 h-4 text-blue-600 rounded border-slate-300 focus:ring-blue-500 focus:ring-offset-0 cursor-pointer" } %>
              <div class="flex items-center gap-1.5">
                <span class="text-sm font-semibold text-slate-800">Admin</span>
                
                <div class="group relative flex items-center">
                  <svg class="w-4 h-4 text-slate-400 group-hover:text-slate-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 hidden group-hover:block whitespace-nowrap px-3 py-1.5 bg-slate-900 text-white text-xs font-medium rounded-xl shadow-xl z-20 pointer-events-none transition-all">
                    Full system administration privileges.
                    <div class="absolute top-full left-1/2 -translate-x-1/2 border-4 border-transparent border-t-slate-900"></div>
                  </div>
                </div>
              </div>
            </div>
          </label>
        </div>
      </div>

      <div data-controller="password-generator" class="space-y-2">
        <div class="flex items-center justify-between mb-2">
          <%= f.label :password, class: "block text-xs font-bold text-slate-500 uppercase tracking-wider" %>
          <button type="button" data-action="click->password-generator#generate" class="text-xs font-bold text-blue-600 hover:text-blue-700 cursor-pointer">
            Generate Password
          </button>
        </div>
        
        <%= f.password_field :password, data: { password_generator_target: "input" }, class: "block w-full px-4 py-3.5 border-2 #{ @employee.errors[:password].any? ? 'border-red-500 bg-red-50/50' : 'border-slate-100 bg-slate-50' } rounded-2xl text-sm font-medium focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 focus:bg-white transition-all" %>
        <%= f.hidden_field :password_confirmation, data: { password_generator_target: "confirmation" } %>
        
        <div data-password-generator-target="display" class="bg-blue-50/80 border border-blue-100 p-4 rounded-2xl mt-3 hidden space-y-1">
          <p class="text-xs font-bold text-blue-900 tracking-wide uppercase">New Password Generated:</p>
          <p class="text-sm font-mono font-bold text-blue-950 select-all" data-password-generator-target="plainView"></p>
          <p class="text-xs text-blue-700 pt-1">Make sure to copy this password. It will not be shown again.</p>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4">
        <%= link_to "Cancel", employees_users_path, class: "px-5 py-3.5 text-sm font-bold text-slate-500 hover:bg-slate-50 rounded-2xl transition-all" %>
        <%= f.submit "Create Employee", class: "px-6 py-3.5 bg-blue-600 text-white text-sm font-bold rounded-2xl shadow-md shadow-blue-100 hover:bg-blue-700 transition-all cursor-pointer" %>
      </div>
    <% end %>
  </div>
</main>
