<main class="flex-1 p-8 lg:p-12">
  <div class="max-w-5xl mx-auto">

    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-10">
      <div>
        <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">Staff Management</h1>
        <p class="text-slate-400 mt-1 text-base">Browse and manage registered staff members.</p>
      </div>
      
      <div class="flex flex-col sm:flex-row items-center gap-3 w-full md:w-auto">
        <%= form_with url: employees_users_path, method: :get, class: "flex items-center gap-3 w-full sm:w-auto" do |f| %>
          <div class="relative w-full sm:w-80"> 
            <div class="absolute inset-y-0 left-0 pl-4 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-slate-400 group-focus-within:text-blue-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <%= f.text_field :query, 
                placeholder: "Search staff...", 
                class: "block w-full pl-12 pr-4 py-3.5 border-2 border-slate-100 rounded-2xl bg-white text-sm font-medium placeholder-slate-400 focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 transition-all shadow-md hover:shadow-lg",
                value: params[:query] %>
          </div>

          <% has_filters = params[:role].present? %>
          <div class="relative">
            <details class="group relative">
              <summary class="list-none flex items-center justify-center p-3.5 border-2 rounded-2xl cursor-pointer shadow-md hover:shadow-lg transition-all select-none focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 <%= has_filters ? 'bg-blue-600 border-blue-600 text-white hover:bg-blue-700' : 'bg-white border-slate-100 text-slate-400 hover:text-blue-600 hover:bg-blue-50' %>" title="Filter Staff">
                <div class="relative flex items-center justify-center">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                  </svg>
                </div>
              </summary>

              <div class="absolute right-0 mt-3 w-80 bg-white rounded-2xl shadow-xl border border-slate-100 p-6 z-50 space-y-4">
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                  <h3 class="font-bold text-slate-900 text-base">Filter Staff</h3>
                  <%= link_to "Reset", employees_users_path(query: params[:query]), class: "text-xs font-semibold text-blue-600 hover:text-blue-800" %>
                </div>

                <div>
                  <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-1.5">User Type</label>
                  <%= select_tag :role, 
                      options_for_select([["All Types", ""], ["Admin", "admin"], ["Employee", "employee"], ["Contractor", "contractor"]], params[:role]), 
                      class: "w-full rounded-xl border-2 border-slate-100 px-3 py-2.5 text-sm font-medium text-slate-700 focus:outline-none focus:ring-4 focus:ring-blue-500/10 focus:border-blue-500 bg-white" %>
                </div>

                <div class="pt-2">
                  <%= f.submit "Apply Filters", class: "w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl shadow-md transition-all text-center cursor-pointer" %>
                </div>
              </div>
            </details>
          </div>
        <% end %>

        <% if current_user.staff? %>
          <%= link_to new_employee_users_path, class: "inline-flex items-center justify-center px-5 py-3.5 bg-blue-600 text-white text-sm font-bold rounded-2xl shadow-md shadow-blue-100 hover:bg-blue-700 transition-all shrink-0 w-full sm:w-auto" do %>
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
            </svg>
            <span>Add New Staff</span>
          <% end %>
        <% end %>
      </div>
    </div>

    <% if @employees.any? %>
      <div class="space-y-3.5">
        <%= render partial: "users/employee_row", collection: @employees, as: :employee %>
      </div>
    <% else %>
      <div class="text-center py-16 bg-slate-50 rounded-3xl border border-dashed border-slate-200">
        <p class="text-slate-400 font-medium">
          <%= params[:query].present? || params[:role].present? ? "No staff found matching your filter criteria." : "No staff have been registered yet." %>
        </p>
      </div>
    <% end %>

  </div>
</main>
